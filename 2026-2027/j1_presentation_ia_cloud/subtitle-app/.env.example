# Tout est facultatif pour un essai : `docker compose up -d --build` fonctionne sans .env.
# Pour un serveur, copier ce fichier en .env puis renseigner les secrets.
# Mot de passe de la base (vide = 'subtitle', acceptable car la base n'est joignable que depuis
# le réseau Docker et cette machine). À fixer AVANT le premier démarrage : le volume garde
# le premier mot de passe utilisé.
POSTGRES_PASSWORD=
# Premier compte administrateur, créé au premier démarrage de la console d'administration
# quand aucun administrateur n'existe encore (le mot de passe fait au moins 8 caractères).
# ADMIN_PASSWORD vide : un mot de passe aléatoire est généré et affiché une seule fois par
#   docker compose logs admin
# Ensuite ces deux valeurs sont ignorées : les comptes vivent en base et se gèrent avec
#   docker compose exec api python -m app.users --help
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Base PostgreSQL, hors Docker uniquement (scripts/run_local.ps1, tests) ; sous Docker l'adresse
# est fixée par docker-compose.yml. Une base locale : docker compose up -d db.
# DATABASE_URL=postgresql+psycopg://subtitle:MOT_DE_PASSE@127.0.0.1:5432/subtitle

# Comptes utilisateurs : l'inscription est ouverte à tous. Durée d'une connexion (jours),
# nombre maximal de créations de compte par heure et par adresse IP, et cookie Secure à
# forcer derrière un reverse proxy HTTPS qui masque le schéma à l'application.
SESSION_DAYS=30
MAX_REGISTRATIONS_PER_HOUR=20
COOKIE_SECURE=false

# Ports d'écoute : application utilisateur et console d'administration.
PORT=8000
ADMIN_PORT=8001

# Matériel : cpu ou gpu (GPU NVIDIA). Normalement fixé par les scripts de lancement
# (scripts/run_docker.ps1 -Device gpu, scripts/run_docker.sh gpu), pas ici.
# Ce choix détermine :
#   - l'image construite (la version gpu embarque les bibliothèques CUDA, 5,4 Go au lieu de 1,7) ;
#   - la précision de calcul : float16 sur GPU, int8 sur CPU ;
#   - le modèle par défaut : whisper-medium.en sur GPU, whisper-small.en sur CPU ;
#   - la taille des lots : 16 sur GPU, 8 sur CPU.
# DEVICE=cpu

# Modèles proposés aux utilisateurs (noms du registre, séparés par des virgules).
# Suffixe .en : anglais uniquement, un peu plus rapide et précis sur l'anglais.
# Sans suffixe : multilingue (français, anglais...), la langue est détectée.
ENABLED_MODELS=whisper-medium.en,whisper-small.en,whisper-medium,whisper-small
# Vide = choisi selon le matériel (voir ci-dessus).
DEFAULT_MODEL=
# Traducteurs activés (vide = pas de traduction proposée).
ENABLED_TRANSLATORS=opus-mt-en-fr

# Identification du speaker : nom d'un identificateur enregistré, vide = désactivé.
SPEAKER_IDENTIFIER=

# Fenêtres audio de 30 s transcrites en un seul passage (plus = plus rapide, plus de mémoire,
# mais barre de progression moins fine). 0 = choisi selon le matériel.
BATCH_SIZE=0
# Sans GPU uniquement : nombre de cœurs utilisés par l'inférence (0 = défaut de la bibliothèque).
CPU_THREADS=0

# Traitements menés de front par worker, dont FAST_LANE_SLOTS réservés aux médias de moins de
# FAST_LANE_MAX_S secondes : un fichier court n'attend jamais derrière des fichiers longs.
WORKER_CONCURRENCY=3
FAST_LANE_SLOTS=1
FAST_LANE_MAX_S=300

# Limites par fichier déposé : taille, et durée (le coût de calcul et la mémoire dépendent de
# la durée, pas du poids).
MAX_UPLOAD_MB=2048
MAX_DURATION_S=7200

# File d'attente. Un nouveau traitement est refusé (« service saturé ») quand la durée de média
# déjà en attente ou en cours, plus la sienne, dépasse MAX_PENDING_MEDIA_S secondes. Ordre de
# grandeur : ce volume met (temps de calcul / durée du média) fois sa durée à s'écouler, soit
# environ 25 min pour 4 h de média sur le CPU de référence avec whisper-small.en.
MAX_PENDING_MEDIA_S=14400
# Traitements en attente ou en cours autorisés pour un même utilisateur.
MAX_PENDING_JOBS_PER_VISITOR=4

# Purge automatique : chaque utilisateur ne garde que les fichiers de son dernier dépôt, et même
# ceux-là sont supprimés après ce nombre de jours (0 = jamais). Les statistiques et le texte
# des réponses restent en base.
RETENTION_DAYS=7

# Préréglage x264 de l'incrustation des sous-titres : ultrafast, superfast, veryfast, faster,
# fast ou medium. Plus rapide = fichier plus lourd (mesures dans docs/ARCHITECTURE.md).
BURN_PRESET=superfast
