# Database of the subtitle application: the official PostgreSQL image, under the
# project's name (subtitle-db) so that every image of the stack is identifiable.
FROM postgres:16-alpine

LABEL org.opencontainers.image.title="subtitle-db" \
      org.opencontainers.image.description="PostgreSQL database of the subtitle application" \
      com.ynov.subtitle.component="database"
