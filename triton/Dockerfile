# Inference server: NVIDIA Triton reduced to the Python backend, with our models.
# Built from the application directory (the translation conversion is shared):
#
#   docker build -f triton/Dockerfile -t subtitle-triton:25.06 .
#
# The official tritonserver:25.06-py3 image carries every backend (TensorRT, PyTorch,
# ONNX Runtime, OpenVINO, DALI...): ~31 GB on disk for a server that only needs the Python
# one. As NVIDIA's compose.py does (server repository, branch r25.06:
#   compose.py --backend python --container-version 25.06), this file starts from the
# minimal image (CUDA, cuDNN, Python) and copies from the full one only the Triton core
# and the Python backend. The full image is needed at build time only.
#
# 25.06 is the first line of releases built on CUDA 12.9: it supports the Blackwell GPUs
# (RTX 50xx) and still ships the CUDA 12 / cuDNN 9 libraries CTranslate2 needs.

# --- Translation models converted to CTranslate2 (same step as the application image,
# so Docker reuses its cache).
FROM python:3.11-slim AS translation-model
WORKDIR /build
COPY requirements-convert.txt scripts/convert_translation_model.py ./
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements-convert.txt \
    && python convert_translation_model.py --output-dir /translation


# --- Source of the Triton binaries only.
FROM nvcr.io/nvidia/tritonserver:25.06-py3 AS full


# --- Triton with the Python backend only (generated by compose.py r25.06, then trimmed of
# the TensorFlow settings that do not apply).
FROM nvcr.io/nvidia/tritonserver:25.06-py3-min

ARG TRITON_VERSION=2.59.0
ARG TRITON_CONTAINER_VERSION=25.06
ENV TRITON_SERVER_VERSION=${TRITON_VERSION} \
    NVIDIA_TRITON_SERVER_VERSION=${TRITON_CONTAINER_VERSION} \
    PATH=/opt/tritonserver/bin:${PATH} \
    UCX_MEM_EVENTS=no \
    TRITON_SERVER_GPU_ENABLED=1 \
    TRITON_SERVER_USER=triton-server \
    DEBIAN_FRONTEND=noninteractive \
    TCMALLOC_RELEASE_RATE=200 \
    PIP_BREAK_SYSTEM_PACKAGES=1

# User 1000 that owns the server files (as in the official image).
RUN userdel tensorrt-server > /dev/null 2>&1 || true \
    && userdel ubuntu > /dev/null 2>&1 || true \
    && if ! id -u $TRITON_SERVER_USER > /dev/null 2>&1; then useradd $TRITON_SERVER_USER; fi \
    && [ "$(id -u $TRITON_SERVER_USER)" -eq 1000 ] && [ "$(id -g $TRITON_SERVER_USER)" -eq 1000 ]

# Runtime libraries of the Triton core.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl libb64-0d libcurl4-openssl-dev libgoogle-perftools-dev libjemalloc-dev libnuma-dev \
    && rm -rf /var/lib/apt/lists/*

# DCGM: the Triton core links to it, for the GPU metrics on port 8002. compose.py installs
# the whole package (2 GB+: cuBLAS proxies, validation suite); the metrics only need the
# library and its modules (~15 MB), copied from the full image at the same version.
ENV DCGM_VERSION=3.3.6
COPY --from=full /usr/lib/x86_64-linux-gnu/libdcgm.so* /usr/lib/x86_64-linux-gnu/libdcgmmodule*.so* /usr/lib/x86_64-linux-gnu/
RUN ldconfig

# Extra defensive wiring for the CUDA compat libraries (as in the official image).
RUN ln -sf ${_CUDA_COMPAT_PATH}/lib.real ${_CUDA_COMPAT_PATH}/lib \
    && echo ${_CUDA_COMPAT_PATH}/lib > /etc/ld.so.conf.d/00-cuda-compat.conf \
    && ldconfig \
    && rm -f ${_CUDA_COMPAT_PATH}/lib

# Python for the Python backend.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-wheel python3-setuptools libpython3-dev libarchive-dev \
    && pip3 install --no-cache-dir --upgrade "numpy<2" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/tritonserver
RUN rm -fr /opt/tritonserver/*
ENV NVIDIA_PRODUCT_NAME="Triton Server"
COPY --from=full /opt/nvidia/entrypoint.d/ /opt/nvidia/entrypoint.d/
COPY --chown=1000:1000 --from=full /opt/tritonserver/LICENSE /opt/tritonserver/TRITON_VERSION ./
COPY --chown=1000:1000 --from=full /opt/tritonserver/bin bin/
COPY --chown=1000:1000 --from=full /opt/tritonserver/lib lib/
COPY --chown=1000:1000 --from=full /opt/tritonserver/backends/python backends/python
RUN chown triton-server:triton-server /opt/tritonserver/backends


# --- Our models.
COPY triton/requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

COPY --from=translation-model /translation /opt/translation
# Shared model code, imported by the one-line model.py of each model directory.
COPY triton/backend /opt/subtitle_models
COPY triton/model_repository /models

LABEL org.opencontainers.image.title="subtitle-triton" \
      org.opencontainers.image.description="Inference server of the subtitle application: Triton (Python backend) with Whisper and OPUS-MT" \
      com.ynov.subtitle.component="inference"

# Whisper weights are downloaded from Hugging Face on first load, into a volume.
ENV PYTHONPATH=/opt/subtitle_models \
    HF_HOME=/hf \
    HF_HUB_DISABLE_PROGRESS_BARS=1

# 8000 HTTP, 8001 gRPC, 8002 Prometheus metrics.
EXPOSE 8000 8001 8002
ENTRYPOINT ["/opt/nvidia/nvidia_entrypoint.sh"]
# Explicit model control: only the models listed with --load-model start with the
# server; the others are loaded on demand by the worker (see docker-compose.gpu.yml).
CMD ["tritonserver", "--model-repository=/models", "--model-control-mode=explicit", \
     "--load-model=translator", "--load-model=whisper_medium_en"]
